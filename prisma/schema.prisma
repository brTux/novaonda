generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum BotStatus {
  ACTIVE
  INACTIVE
  DISCONNECTED
}

enum FlowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NodeType {
  TRIGGER
  MESSAGE
  IMAGE
  VIDEO
  AUDIO
  INPUT
  CONDITION
  DELAY
  ACTION
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
}

enum MessageSender {
  USER
  BOT
  AGENT
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum PaymentProvider {
  PUSHINPAY
  ASAAS
  MERCADOPAGO
}

enum TransactionStatus {
  PENDING
  PAID
  EXPIRED
  REFUNDED
}

// Models

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?   // Hashed, if using credentials auth
  image         String?
  plan          SubscriptionPlan @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  
  bots          Bot[]
  campaigns     Campaign[]
  pressells     Pressell[]
  paymentCredentials PaymentCredential[]
  
  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
  @@map("accounts")
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("sessions")
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
  @@map("verification_tokens")
}

model Bot {
  id            String    @id @default(cuid())
  name          String
  token         String    @unique // Telegram Bot Token
  username      String?
  status        BotStatus @default(INACTIVE)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  flows         Flow[]
  conversations Conversation[]
  campaigns     Campaign[]
  pressells     Pressell[]
  
  // Meta Tracking (Phase 5)
  pixelId       String?
  capiToken     String?
  testEventCode String? // Use for Test Events in Events Manager
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("bots")
}

model Flow {
  id            String     @id @default(cuid())
  name          String
  description   String?
  isDefault     Boolean    @default(false) // Default flow for new chats
  status        FlowStatus @default(DRAFT)
  botId         String
  bot           Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  
  nodes         FlowNode[]
  edges         FlowEdge[]
  campaigns     Campaign[]
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("flows")
}

model FlowNode {
  id            String    @id @default(cuid())
  flowId        String
  flow          Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  type          NodeType
  positionX     Float
  positionY     Float
  data          Json      // Node specific configuration (content, options, etc)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("flow_nodes")
}

model FlowEdge {
  id            String    @id @default(cuid())
  flowId        String
  flow          Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  sourceNodeId  String
  sourceHandle  String?
  targetNodeId  String
  targetHandle  String?
  label         String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("flow_edges")
}

model Conversation {
  id            String    @id @default(cuid())
  botId         String
  bot           Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  telegramChatId String   // Chat ID from Telegram
  telegramUserId String?  // User ID from Telegram
  firstName     String?
  lastName      String?
  username      String?
  status        String?   // OPEN, CLOSED, WAITING_AGENT
  tags          String[]
  
  waitingForNodeId String? // ID of the node that is waiting for input
  waitingTimeout   DateTime?
  
  // Tracking & Geo Details (Phase 5)
  ip             String?
  city           String?
  state          String?
  latitude       Float?
  longitude      Float?
  
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  
  fbc            String?   // Facebook Click ID
  fbp            String?   // Facebook Browser ID
  
  isPaused      Boolean   @default(false)
  
  messages       Message[]
  transactions   Transaction[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([botId, telegramChatId])
  @@map("conversations")
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String?
  type           MessageType   @default(TEXT)
  sender         MessageSender
  mediaUrl       String?
  
  createdAt      DateTime      @default(now())

  @@map("messages")
}

model Campaign {
  id            String         @id @default(cuid())
  name          String
  status        CampaignStatus @default(DRAFT)
  scheduledAt   DateTime?
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  botId         String?
  bot           Bot?           @relation(fields: [botId], references: [id], onDelete: SetNull)
  
  flowId        String?
  flow          Flow?          @relation(fields: [flowId], references: [id], onDelete: SetNull)
  
  totalLeads    Int            @default(0)
  sentCount     Int            @default(0)
  deliveredCount Int           @default(0)
  readCount     Int            @default(0)
  failedCount   Int            @default(0)
  
  leads         CampaignLead[]
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("campaigns")
}

model CampaignLead {
  id            String    @id @default(cuid())
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  telegramChatId String
  status        String    @default("PENDING") // PENDING, SENT, FAILED
  error         String?
  sentAt        DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([campaignId, telegramChatId])
  @@map("campaign_leads")
}

model Pressell {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  vslUrl      String
  buttonText  String   @default("Continuar no Telegram")
  pixelId     String?
  safeUrl     String?  // URL Branca (Cloaking)
  config      Json?    // Configurações do Builder (blocos, quiz, etc)
  
  botId       String
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leadTrackings LeadTracking[]
  
  @@map("pressells")
}

model LeadTracking {
  id             String   @id @default(cuid())
  ip             String?
  city           String?
  state          String?
  latitude       Float?
  longitude      Float?
  
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  
  pressellId     String?
  pressell       Pressell? @relation(fields: [pressellId], references: [id], onDelete: SetNull)
  
  fbc            String?
  fbp            String?
  
  createdAt      DateTime @default(now())
  
  @@map("lead_tracking")
}

model PaymentCredential {
  id          String         @id @default(cuid())
  provider    PaymentProvider
  token       String         // API Key / Token
  secret      String?        // Client Secret (if needed)
  description String?
  isActive    Boolean        @default(true)
  
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, provider])
  @@map("payment_credentials")
}

model Transaction {
  id             String            @id @default(cuid())
  externalId     String?           @unique // ID in the payment gateway
  provider       PaymentProvider
  amount         Int               // Value in cents
  status         TransactionStatus @default(PENDING)
  pixCopyPaste   String?
  pixQrCodeBase64 String?
  
  paidTag        String?           // Tag to apply to the conversation when paid
  metadata       Json?             // Additional data for the transaction
  
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  paidAt         DateTime?
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("transactions")
}
